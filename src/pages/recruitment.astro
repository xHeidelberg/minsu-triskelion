---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { steps, requirements, benefits, faqs } from '../data/site';
import { wrap, section, h2, btnGold } from '../data/ui';
---
<Layout title="Recruitment">
  <PageHero title="Recruitment" intro="Interested in becoming a Triskelion? See what you get, what we ask for, and how to start." />

  <section class={section}>
    <div class={wrap}>
      <h2 class={`${h2} mb-8`}>Why join</h2>
      <div class="grid gap-6 md:grid-cols-3">
        {benefits.map(([t, d]) => (
          <div class="rounded-2xl border-t-4 border-gold bg-cream p-6">
            <h3 class="mb-2 font-display text-xl font-bold">{t}</h3>
            <p class="text-sm text-muted">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class={`${section} bg-ink text-white`}>
    <div class={`${wrap} grid gap-12 md:grid-cols-2`}>
      <div>
        <h2 class={`${h2} mb-8`}>How to join</h2>
        <ol class="grid gap-5">
          {steps.map(([t, d], i) => (
            <li class="flex gap-4">
              <span class="grid size-10 flex-none place-items-center rounded-full bg-gold font-extrabold text-ink">{i + 1}</span>
              <div><h3 class="font-bold">{t}</h3><p class="text-sm text-cream/75">{d}</p></div>
            </li>
          ))}
        </ol>
      </div>
      <div>
  <h2 class={`${h2} mb-8`}>Requirements</h2>
  <ul class="grid gap-3">
    {requirements.map((r, index) => {
      // Split the requirement into a short title and a full description if it's long, 
      // or use the whole text as the body. Here we make the first 8 words the bold header.
      const words = r.split(' ');
      const shortTitle = words.slice(0, 6).join(' ') + '...';
      
      return (
        <li class="rounded-lg border border-white/15 bg-white/5 transition-colors hover:border-gold/50">
          <details class="group p-4">
            <summary class="flex cursor-pointer items-center justify-between gap-4 font-semibold text-cream/90 list-none select-none">
              <div class="flex items-center gap-3">
                <svg class="flex-none text-gold" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7"/></svg>
                <span class="text-sm md:text-base">{shortTitle}</span>
              </div>
              <!-- Animated chevron arrow -->
              <svg class="size-5 flex-none text-gold transition-transform duration-300 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <!-- Expanded text content -->
            <p class="mt-3 pl-8 text-sm text-cream/70 leading-relaxed border-t border-white/10 pt-3">
              {r}
            </p>
          </details>
        </li>
      );
    })}
  </ul>
</div>
  </section>

  <section class={`${section} bg-cream`}>
    <div class={`${wrap} max-w-3xl`}>
      <h2 class={`${h2} mb-8`}>Common questions</h2>
      <div class="divide-y divide-ink/15 rounded-xl border border-ink/15 bg-white">
        {faqs.map(([q, a]) => (
          <details class="group p-4">
            <summary class="flex min-h-8 cursor-pointer list-none items-center justify-between gap-4 font-bold [&::-webkit-details-marker]:hidden">
              {q}
              <span class="text-2xl leading-none text-gold transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-sm text-muted">{a}</p>
          </details>
        ))}
      </div>
      <div class="mt-10 text-center">
        <p class="mb-4 text-muted">Ready to start?</p>
        <a href="/contact" class={btnGold}>Ask about recruitment</a>
      </div>
    </div>
  </section>
</Layout>
---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import Placeholder from '../components/Placeholder.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, heroImages, officers, projects } from '../data/site';
import { wrap, section, h2, btnGold, btnLine, btnDark } from '../data/ui';
import aboutImg from '../assets/about.jpeg';
const years = new Date().getFullYear() - site.foundedYear;
const grand = officers[0];
---
<Layout>
  <!-- Hero: automatic image slideshow (no user controls) -->
  <section class="relative isolate overflow-hidden bg-forest text-white">
    <div class="pointer-events-none absolute inset-0 -z-10 select-none" aria-hidden="true">
      {heroImages.map((src, i) => (
        <img src={src} alt="" data-slide loading="eager" fetchpriority={i === 0 ? 'high' : 'auto'} draggable="false"
          onerror="this.style.display='none'"
          class:list={['absolute inset-0 size-full object-cover transition-opacity duration-1000 motion-reduce:transition-none', i === 0 ? 'opacity-100' : 'opacity-0']} />
      ))}
      <div class="absolute inset-0 bg-linear-to-r from-deep/90 via-deep/65 to-deep/30"></div>
    </div>
    <div class={`${wrap} flex min-h-[80svh] items-center py-16 md:py-24`}>
  <div class="max-w-2xl">
    <!-- Eyebrow Badge -->
    <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-gold/30 bg-gold/10 px-3.5 py-1 text-xs font-bold tracking-wide text-gold uppercase backdrop-blur-sm">
      <span>{site.org}</span>
      <span class="text-gold/40">•</span>
      <span>Mindoro State University - Bongabong Chapter</span>
      <span class="text-gold/40">•</span>
      <span>Est. {site.founded}</span>
    </div>

    <!-- Main Headline -->
    <h1 class="mb-5 font-display text-4xl font-extrabold tracking-tight leading-[1.1] text-white md:text-6xl">
      United in Brotherhood.<br class="hidden sm:inline" /> Driven by Service.
    </h1>

    <!-- Subtitle / Intro Text -->
    <p class="mb-8 max-w-[52ch] text-base leading-relaxed text-cream/90 md:text-lg">
Empowering Triskelions to lead with integrity, pursue academic excellence, and forge exemplary character—driving meaningful impact across Mindoro State University and beyond through active collaboration with collegiate and community chapters, municipal councils, and provincial governance networks.    </p>

    <!-- Calls to Action -->
    <div class="flex flex-wrap items-center gap-4">
      <a href="/recruitment" class={`${btnGold} transition-transform hover:-translate-y-0.5 shadow-lg shadow-gold/10`}>
        Join Us
      </a>
      <a href="/about" class={`${btnLine} transition-all hover:bg-white/10`}>
        Explore Our Legacy
      </a>
    </div>
  </div>
</div>
  </section>

  <!-- Facts -->
  <section class="bg-gold text-ink">
  <dl class={`${wrap} grid divide-y divide-ink/20 text-center sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4 lg:divide-x`}>
    <div class="py-4 px-2">
      <dt class="text-sm font-semibold">Service Hours</dt>
        <dd class="font-display text-2xl font-bold">
          {site.hrsService}+
          <br>
          <span class="text-xs font-normal opacity-80">as of Academic Year '26-'27</span>
        </dd>
    </div>
    <div class="py-4 px-2">
      <dt class="text-sm font-semibold">Chapter founded</dt>
      <dd class="font-display text-lg font-bold">{site.founded}</dd>
    </div>
    <div class="py-4 px-2">
      <dt class="text-sm font-semibold">Years of service</dt>
      <dd class="font-display text-xl font-bold">{years} years</dd>
    </div>
    <div class="py-4 px-2">
      <dt class="text-sm font-semibold">Based in</dt>
      <dd class="font-display text-lg font-bold">Brgy. Labasan, Bongabong, Oriental Mindoro</dd>
    </div>
  </dl>
</section>

  <!-- About teaser -->
  <section class={`${section} bg-cream`}>
  <div class={`${wrap} grid items-center gap-10 md:grid-cols-2 md:gap-14`}>
    <Image src={aboutImg} alt="Who We Are" class="order-2 aspect-[4/3] w-full rounded-2xl object-cover md:order-1" />
    <div class="order-1 md:order-2">
      <h2 class={`${h2} mb-4`}>Who We Are</h2>
      <p class="mb-6 max-w-[60ch] text-muted">
        The {site.name} ({site.org}) is an official academic and community-oriented student chapter dedicated to cultivating principled leadership, academic excellence, and enduring brotherhood across Mindoro State University.
      </p>
      <a href="/about" class={btnDark}>Read Our Story</a>
    </div>
  </div>
</section>

  <!-- Leadership teaser -->
  <section class={section}>
    <div class={wrap}>
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 class={h2}>Our leadership</h2>
        <a href="/leadership" class="font-bold text-forest underline decoration-gold decoration-2 underline-offset-4">See all officers</a>
      </div>
      <article class="grid overflow-hidden rounded-2xl bg-forest text-white sm:grid-cols-[2fr_3fr]">
        {grand.img
          ? <img src={grand.img} alt={grand.position} class="aspect-[4/3] size-full object-cover sm:aspect-auto" />
          : <Placeholder class="aspect-[4/3] sm:aspect-auto" />}
        <div class="flex flex-col justify-center p-6 md:p-10">
          <p class="mb-1 text-sm font-bold text-gold">{grand.position}</p>
          <h3 class="font-display text-2xl font-bold md:text-3xl">{grand.name}</h3>
          <p class="mt-3 max-w-[50ch] text-cream/80">{grand.duties[0]}. {grand.duties[1]}.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- Projects teaser -->
  <section class={`${section} bg-cream`}>
    <div class={wrap}>
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 class={h2}>Recent projects</h2>
        <a href="/projects" class="font-bold text-forest underline decoration-gold decoration-2 underline-offset-4">See all projects</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {projects.slice(0, 3).map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>

  <!-- Recruitment CTA -->
  <section class={`${section} bg-ink text-white`}>
    <div class={`${wrap} flex flex-wrap items-center justify-between gap-6`}>
      <div>
        <h2 class={`${h2} mb-3`}>Become a Triskelion</h2>
        <p class="max-w-[52ch] text-cream/80">Learn what it takes to join the chapter and how to get started.</p>
      </div>
      <a href="/recruitment" class={btnGold}>See how to join</a>
    </div>
  </section>
</Layout>

<script>
  // Hero slideshow: changes by itself every 5 seconds
  const slides = [...document.querySelectorAll<HTMLElement>('[data-slide]')];
  if (slides.length > 1) {
    let cur = 0;
    setInterval(() => {
      slides[cur].classList.replace('opacity-100', 'opacity-0');
      cur = (cur + 1) % slides.length;
      slides[cur].classList.replace('opacity-0', 'opacity-100');
    }, 5000);
  }
</script>